<Window x:Class="ProgrammingTasks.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="База задач по программированию" Height="620" Width="1100" Background="#121212" Foreground="#E0E0E0">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0"><TextBlock Text="Задачи по программированию" FontSize="26" FontWeight="Bold" Foreground="#D7A84B"/><TextBlock x:Name="UserLabel" DockPanel.Dock="Right" Margin="20,8,0,0"/></DockPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,12"><TextBlock Text="Сложность от:" VerticalAlignment="Center"/><TextBox x:Name="MinDifficulty" Width="50" Margin="8,0,14,0" Text="1"/><TextBlock Text="до:" VerticalAlignment="Center"/><TextBox x:Name="MaxDifficulty" Width="50" Margin="8,0,14,0" Text="10"/><TextBlock Text="Теги:" VerticalAlignment="Center"/><TextBox x:Name="TagsFilter" Width="130" Margin="8,0,14,0"/><Button Content="Применить" Click="FilterClick" Padding="9,6" Background="#D7A84B"/><Button Content="Сбросить" Click="ResetClick" Margin="5,0,0,0" Padding="9,6"/><Button x:Name="AddButton" Content="Добавить" Click="AddClick" Margin="5,0,0,0" Padding="9,6"/><Button x:Name="EditButton" Content="Изменить" Click="EditClick" Margin="5,0,0,0" Padding="9,6"/><Button x:Name="DeleteButton" Content="Удалить" Click="DeleteClick" Margin="5,0,0,0" Padding="9,6"/><Button Content="Отчёт" Click="ReportClick" Margin="5,0,0,0" Padding="9,6"/><Button Content="CSV" Click="ExportClick" Margin="5,0,0,0" Padding="9,6"/><Button x:Name="CatalogButton" Content="Справочники" Click="CatalogClick" Margin="5,0,0,0" Padding="9,6"/><Button x:Name="UsersButton" Content="Пользователи" Click="UsersClick" Margin="5,0,0,0" Padding="9,6"/></StackPanel>
    <DataGrid Grid.Row="2" x:Name="TasksGrid" MouseDoubleClick="TaskDoubleClick" AutoGenerateColumns="False" IsReadOnly="True" Background="#1E1E1E" Foreground="#E0E0E0"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Сложность" Binding="{Binding Difficulty}" Width="90"/><DataGridTextColumn Header="Теги" Binding="{Binding TagsText}" Width="2*"/><DataGridTextColumn Header="Контесты" Binding="{Binding ContestsText}" Width="2*"/><DataGridCheckBoxColumn Header="Codeforces" Binding="{Binding PreparedForCodeforces}" Width="100"/><DataGridCheckBoxColumn Header="Yandex" Binding="{Binding PreparedForYandexContest}" Width="80"/></DataGrid.Columns></DataGrid>
  </Grid>
</Window>
