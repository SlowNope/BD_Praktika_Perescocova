<Window x:Class="ProgrammingTasks.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ProgrammingTasks — база задач" Height="720" Width="1180" WindowStartupLocation="CenterScreen" Background="#121212" Foreground="#E0E0E0" PreviewKeyDown="WindowPreviewKeyDown">
  <Window.Resources><SolidColorBrush x:Key="TextBrush" Color="#F2F2F2"/><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="FontSize" Value="15"/></Style><Style TargetType="TabItem"><Setter Property="Padding" Value="20,10"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="#DCDCDC"/><Setter Property="Background" Value="#202124"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#121212"/><Setter Property="Background" Value="#D7A84B"/></Trigger></Style.Triggers></Style><Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#34363B"/><Setter Property="Foreground" Value="#F2F2F2"/></Style><Style TargetType="TextBox"><Setter Property="Background" Value="#2B2D31"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#555A63"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="6,4"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#34363B"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,7"/></Style></Window.Resources>
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ProgrammingTasks" FontSize="28" FontWeight="Bold" Foreground="#D7A84B" VerticalAlignment="Center"/><TextBlock x:Name="UserLabel" Grid.Column="2" VerticalAlignment="Center" Foreground="#D0D4DA" Margin="20,0,12,0"/><Button x:Name="SwitchUserButton" Grid.Column="3" Content="Сменить пользователя" Click="SwitchUserClick" Margin="4,0,0,0"/></Grid>
    <TabControl x:Name="MainTabs" Grid.Row="1" Background="#1E1E1E">
      <TabItem Header="Задачи"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#252526" Padding="14" CornerRadius="5"><WrapPanel VerticalAlignment="Center"><TextBlock Text="Сложность" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="DifficultyRangeText" Width="90" Text="1–10" ToolTip="Введите диапазон от 1 до 10, например 3–7" Margin="0,0,18,0"/><TextBlock Text="Теги" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,8,0"/><TextBox x:Name="TagsFilter" Width="220" ToolTip="Введите один или несколько тегов через запятую" Margin="0,0,14,0"/><Button Content="Применить" Click="FilterClick" Background="#B8872F"/><Button Content="Сбросить" Click="ResetClick"/><Button Content="Отчёт" Click="ReportClick"/><Button Content="CSV" Click="ExportClick"/></WrapPanel></Border><DataGrid Grid.Row="1" x:Name="TasksGrid" Margin="0,12" MouseDoubleClick="TaskDoubleClick" AutoGenerateColumns="False" IsReadOnly="True" Background="#1E1E1E" Foreground="#F2F2F2" RowBackground="#1E1E1E" AlternatingRowBackground="#252526" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Название задачи" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Сложность" Binding="{Binding Difficulty}" Width="100"/><DataGridTextColumn Header="Теги" Binding="{Binding TagsText}" Width="2*"/><DataGridTextColumn Header="Контесты" Binding="{Binding ContestsText}" Width="2*"/><DataGridTextColumn Header="Codeforces" Binding="{Binding CodeforcesStatus}" Width="110"/><DataGridTextColumn Header="Yandex" Binding="{Binding YandexStatus}" Width="90"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="Назад" Click="BackClick"/><Button x:Name="AddButton" Content="Добавить задачу" Click="AddClick"/><Button x:Name="EditButton" Content="Изменить" Click="EditClick"/><Button x:Name="DeleteButton" Content="Удалить" Click="DeleteClick"/><TextBlock Text="Двойной щелчок по строке — подробности" Foreground="#BFC3CA" VerticalAlignment="Center" Margin="18,0"/></StackPanel></Grid></TabItem>
      <TabItem x:Name="AdminTab" Header="Администрирование"><StackPanel Margin="20"><TextBlock Text="Панель администратора" FontSize="22" Foreground="#D7A84B" Margin="0,0,0,18"/><TextBlock Text="Управление справочниками и пользователями" Foreground="#F2F2F2" Margin="0,0,0,18"/><WrapPanel><Button x:Name="CatalogButton" Content="Теги и контесты" Click="CatalogClick"/><Button x:Name="UsersButton" Content="Пользователи" Click="UsersClick"/></WrapPanel></StackPanel></TabItem>
      <TabItem Header="Как пользоваться"><ScrollViewer Margin="20"><StackPanel><TextBlock Text="Зачем нужна программа" FontSize="24" Foreground="#D7A84B"/><TextBlock Text="Это каталог задач по программированию для подготовки контестов. В нём хранятся условия, идеи решений, сложность, теги, контесты и ссылки Polygon." TextWrapping="Wrap" Foreground="#F2F2F2" FontSize="16" Margin="0,12,0,20"/><TextBlock Text="Режим пользователя" FontSize="19" Foreground="#D7A84B"/><TextBlock Text="1. Войдите как user1 без пароля.&#x0a;2. Введите диапазон сложности, например 3–7.&#x0a;3. Введите теги через запятую и нажмите Применить.&#x0a;4. Дважды щёлкните задачу, чтобы открыть условие и идею решения.&#x0a;5. Сформируйте отчёт или экспортируйте текущую выборку в CSV." TextWrapping="Wrap" Foreground="#F2F2F2" FontSize="15" Margin="0,10,0,20"/><TextBlock Text="Режим администратора" FontSize="19" Foreground="#D7A84B"/><TextBlock Text="Войдите как root с паролем Madmin1!. Администратор может добавлять, изменять и удалять задачи, управлять тегами, контестами и менеджерами." TextWrapping="Wrap" Foreground="#F2F2F2" FontSize="15" Margin="0,10,0,0"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
  </Grid>
</Window>
