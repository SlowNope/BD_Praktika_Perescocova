<Window x:Class="ProgrammingTasks.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ProgrammingTasks — база задач" Height="720" Width="1180" WindowStartupLocation="CenterScreen" Background="#121212" Foreground="#E0E0E0">
  <Window.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="18,9"/><Setter Property="FontSize" Value="14"/></Style><Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/></Style></Window.Resources>
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="ProgrammingTasks" FontSize="28" FontWeight="Bold" Foreground="#D7A84B"/><TextBlock x:Name="UserLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#9E9E9E"/></DockPanel>
    <TabControl Grid.Row="1" Background="#1E1E1E">
      <TabItem Header="Задачи"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#252526" Padding="12" CornerRadius="5"><WrapPanel VerticalAlignment="Center"><TextBlock Text="Сложность:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="MinDifficulty" Width="70" IsEditable="True" Text="1" Margin="0,0,12,0"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/></ComboBox><TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="MaxDifficulty" Width="70" IsEditable="True" Text="10" Margin="0,0,16,0"><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/></ComboBox><TextBlock Text="Тег:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="TagsFilter" Width="220" IsEditable="True" ToolTip="Выберите тег или введите несколько через запятую" Margin="0,0,12,0"/><Button Content="Применить фильтр" Click="FilterClick" Background="#D7A84B"/><Button Content="Сбросить" Click="ResetClick"/><Button Content="Отчёт" Click="ReportClick"/><Button Content="Экспорт CSV" Click="ExportClick"/></WrapPanel></Border>
        <DataGrid Grid.Row="1" x:Name="TasksGrid" Margin="0,12" MouseDoubleClick="TaskDoubleClick" AutoGenerateColumns="False" IsReadOnly="True" Background="#1E1E1E" Foreground="#E0E0E0" RowBackground="#1E1E1E" AlternatingRowBackground="#252526" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Название задачи" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Сложность" Binding="{Binding Difficulty}" Width="100"/><DataGridTextColumn Header="Теги" Binding="{Binding TagsText}" Width="2*"/><DataGridTextColumn Header="Контесты" Binding="{Binding ContestsText}" Width="2*"/><DataGridCheckBoxColumn Header="Codeforces" Binding="{Binding PreparedForCodeforces}" Width="110"/><DataGridCheckBoxColumn Header="Yandex" Binding="{Binding PreparedForYandexContest}" Width="90"/></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="AddButton" Content="Добавить задачу" Click="AddClick"/><Button x:Name="EditButton" Content="Изменить" Click="EditClick"/><Button x:Name="DeleteButton" Content="Удалить" Click="DeleteClick"/><TextBlock Text="Двойной щелчок по строке — подробности" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="18,0"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="Администрирование"><StackPanel Margin="20"><TextBlock Text="Панель администратора" FontSize="22" Foreground="#D7A84B" Margin="0,0,0,18"/><TextBlock Text="Раздел доступен только пользователю root." Foreground="#9E9E9E" Margin="0,0,0,18"/><WrapPanel><Button x:Name="CatalogButton" Content="Теги и контесты" Click="CatalogClick"/><Button x:Name="UsersButton" Content="Пользователи" Click="UsersClick"/></WrapPanel></StackPanel></TabItem>
      <TabItem Header="Справка"><StackPanel Margin="20"><TextBlock Text="О приложении" FontSize="22" Foreground="#D7A84B"/><TextBlock Text="База задач по программированию с фильтрацией, контестами, тегами и отчётами." TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="Для просмотра подробностей дважды щёлкните задачу в таблице." Foreground="#9E9E9E" Margin="0,8,0,0"/></StackPanel></TabItem>
    </TabControl>
  </Grid>
</Window>
