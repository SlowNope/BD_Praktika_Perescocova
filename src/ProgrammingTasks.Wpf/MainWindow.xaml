<Window x:Class="ProgrammingTasks.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ProgrammingTasks — база задач" Height="720" Width="1180" WindowStartupLocation="CenterScreen" Background="#121212" Foreground="#E0E0E0">
  <Window.Resources><SolidColorBrush x:Key="PanelBrush" Color="#202124"/><SolidColorBrush x:Key="InputBrush" Color="#2B2D31"/><SolidColorBrush x:Key="TextBrush" Color="#F2F2F2"/><Style TargetType="TabItem"><Setter Property="Padding" Value="20,10"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="#DCDCDC"/><Setter Property="Background" Value="#202124"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#121212"/><Setter Property="Background" Value="#D7A84B"/></Trigger></Style.Triggers></Style><Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#34363B"/><Setter Property="Foreground" Value="#F2F2F2"/></Style><Style TargetType="TextBox"><Setter Property="Background" Value="#2B2D31"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#555A63"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="6,4"/></Style><Style TargetType="ComboBox"><Setter Property="Background" Value="#2B2D31"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#555A63"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="4"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#34363B"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,7"/></Style></Window.Resources>
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="ProgrammingTasks" FontSize="28" FontWeight="Bold" Foreground="#D7A84B"/><TextBlock x:Name="UserLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#9E9E9E"/></DockPanel>
    <TabControl Grid.Row="1" Background="#1E1E1E">
      <TabItem Header="Задачи"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#252526" Padding="14" CornerRadius="5"><WrapPanel VerticalAlignment="Center"><TextBlock Text="Сложность" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="DifficultyRangeText" Width="90" Text="1–10" ToolTip="Введите диапазон, например 1–10" Margin="0,0,18,0"/><TextBlock Text="Теги" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/><ComboBox x:Name="TagsFilter" Width="220" IsEditable="True" ToolTip="Введите один или несколько тегов через запятую" Margin="0,0,14,0"/><Button Content="Применить" Click="FilterClick" Background="#B8872F"/><Button Content="Сбросить" Click="ResetClick"/><Button Content="Отчёт" Click="ReportClick"/><Button Content="CSV" Click="ExportClick"/></WrapPanel></Border>
        <DataGrid Grid.Row="1" x:Name="TasksGrid" Margin="0,12" MouseDoubleClick="TaskDoubleClick" AutoGenerateColumns="False" IsReadOnly="True" Background="#1E1E1E" Foreground="#F2F2F2" RowBackground="#1E1E1E" AlternatingRowBackground="#252526" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Название задачи" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Сложность" Binding="{Binding Difficulty}" Width="100"/><DataGridTextColumn Header="Теги" Binding="{Binding TagsText}" Width="2*"/><DataGridTextColumn Header="Контесты" Binding="{Binding ContestsText}" Width="2*"/><DataGridTextColumn Header="Codeforces" Binding="{Binding CodeforcesStatus}" Width="110"/><DataGridTextColumn Header="Yandex" Binding="{Binding YandexStatus}" Width="90"/></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="AddButton" Content="Добавить задачу" Click="AddClick"/><Button x:Name="EditButton" Content="Изменить" Click="EditClick"/><Button x:Name="DeleteButton" Content="Удалить" Click="DeleteClick"/><TextBlock Text="Двойной щелчок по строке — подробности" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="18,0"/></StackPanel>
      </Grid></TabItem>
      <TabItem x:Name="AdminTab" Header="Администрирование"><StackPanel Margin="20"><TextBlock Text="Панель администратора" FontSize="22" Foreground="#D7A84B" Margin="0,0,0,18"/><TextBlock Text="Управление справочниками и пользователями" Foreground="#BFC3CA" Margin="0,0,0,18"/><WrapPanel><Button x:Name="CatalogButton" Content="Теги и контесты" Click="CatalogClick"/><Button x:Name="UsersButton" Content="Пользователи" Click="UsersClick"/></WrapPanel></StackPanel></TabItem>
      <TabItem Header="Справка"><StackPanel Margin="20"><TextBlock Text="О приложении" FontSize="22" Foreground="#D7A84B"/><TextBlock Text="База задач по программированию с фильтрацией, контестами, тегами и отчётами." TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="Для просмотра подробностей дважды щёлкните задачу в таблице." Foreground="#9E9E9E" Margin="0,8,0,0"/></StackPanel></TabItem>
    </TabControl>
  </Grid>
</Window>
