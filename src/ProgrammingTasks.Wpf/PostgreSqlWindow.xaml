<Window x:Class="ProgrammingTasks.Wpf.PostgreSqlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Подключение PostgreSQL" Height="430" Width="560" WindowStartupLocation="CenterOwner" Background="#121212" Foreground="#F2F2F2"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Подключение к PostgreSQL" FontSize="22" Foreground="#D7A84B" Margin="0,0,0,18"/><TextBlock Text="Сервер" Grid.Row="1"/><TextBox x:Name="HostText" Grid.Row="1" Margin="150,0,0,8"/><TextBlock Text="Порт" Grid.Row="2"/><TextBox x:Name="PortText" Grid.Row="2" Margin="150,0,0,8"/><TextBlock Text="Имя базы данных" Grid.Row="3"/><TextBox x:Name="DatabaseText" Grid.Row="3" Margin="150,0,0,8"/><TextBlock Text="Пользователь" Grid.Row="4"/><TextBox x:Name="UsernameText" Grid.Row="4" Margin="150,0,0,8"/><TextBlock Text="Пароль" Grid.Row="5"/><PasswordBox x:Name="PasswordText" Grid.Row="5" Margin="150,0,0,8"/><TextBlock Text="После проверки данные SQLite будут перенесены в PostgreSQL, а приложение переключится на неё." Grid.Row="6" TextWrapping="Wrap" Foreground="#BFC3CA" Margin="0,8,0,12"/><StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Проверить и подключить" Click="ConnectClick" Background="#B8872F"/><Button Content="Отмена" Click="CancelClick"/></StackPanel></Grid></Window>
