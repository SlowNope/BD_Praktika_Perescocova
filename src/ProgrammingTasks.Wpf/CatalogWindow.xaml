<Window x:Class="ProgrammingTasks.Wpf.CatalogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Справочники" Height="500" Width="700" WindowStartupLocation="CenterOwner" Background="#121212" Foreground="#E0E0E0"><Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Теги" FontSize="20" Foreground="#D7A84B"/><ListBox x:Name="TagsList" Height="300"/><TextBox x:Name="TagText" Margin="0,10,0,5"/><Button Content="Добавить тег" Click="AddTagClick" Padding="10"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Контесты" FontSize="20" Foreground="#D7A84B"/><ListBox x:Name="ContestsList" Height="300"/><TextBox x:Name="ContestText" Margin="0,10,0,5"/><Button Content="Добавить контест" Click="AddContestClick" Padding="10"/></StackPanel></Grid></Window>
