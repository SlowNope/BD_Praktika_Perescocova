<Window x:Class="ProgrammingTasks.Wpf.UsersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Пользователи" Height="500" Width="620" WindowStartupLocation="CenterOwner" Background="#121212" Foreground="#E0E0E0"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="UsersList" DisplayMemberPath="Login"/><StackPanel Grid.Row="1" Margin="0,12"><TextBlock Text="Логин нового менеджера"/><TextBox x:Name="LoginText" Margin="0,4,0,8"/><TextBlock Text="Пароль"/><PasswordBox x:Name="PasswordText" Margin="0,4,0,8"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Добавить менеджера" Click="AddClick" Padding="12,7" Background="#D7A84B"/><Button Content="Удалить выбранного" Click="DeleteClick" Margin="10,0,0,0" Padding="12,7"/></StackPanel></Grid></Window>
